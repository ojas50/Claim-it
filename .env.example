# Claim-It environment variables
# Copy this file to .env and fill in the key for live mode.

# true  = canned demo responses, no Sarvam API calls (default)
# false = call Sarvam Saaras / Vision / 105B / Bulbul live
MOCK_MODE=true

# Required only when MOCK_MODE=false.
# Get a key from https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Optional frontend override. Leave empty to use the Vite dev proxy.
# VITE_API_BASE=http://127.0.0.1:8000
